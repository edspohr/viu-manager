rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    // True when the requester is authenticated AND their /users/{uid} doc
    // exists AND their role is admin or superadmin. Pending users are
    // explicitly excluded from any shared-data access.
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function isSuperadmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // ── Users collection ─────────────────────────────────────────────────────
    // Authenticated users can read/write their own doc.
    // Superadmins can read and update any user doc (role assignment).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if isSuperadmin();
    }

    // ── Orders collection ────────────────────────────────────────────────────
    // - get (read a single order by ID): allowed without auth, so the public
    //   approval link works on any device. The order ID acts as an
    //   unguessable token.
    // - list (enumerate the collection): staff only.
    // - create / delete / staff update: staff only (blocks pending accounts).
    // - update: staff, OR an unauthenticated client signing the approval
    //   (isClientApprovalUpdate).
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isStaff();

      allow create, delete: if isStaff();

      allow update: if isStaff() || isClientApprovalUpdate();
    }

    // Returns true when the only fields changing on /orders/{id} are the
    // approval-signature fields, the previous state was "Enviada al Cliente",
    // the new state is "Aceptada", and a non-empty RUN + signature are set.
    // This is the exact write the public approval page performs.
    function isClientApprovalUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      // Only these fields may change in an unauthenticated update.
      let allowedChanges = ['status', 'approvalStatus', 'approvalRun',
                            'approvalTimestamp', 'approvalSignatureDataUrl'];
      let diff = after.diff(before).affectedKeys();
      return before.status == 'Enviada al Cliente'
        && after.status == 'Aceptada'
        && after.approvalStatus == 'approved'
        && after.approvalRun is string && after.approvalRun.size() >= 8
        && after.approvalSignatureDataUrl is string && after.approvalSignatureDataUrl.size() > 0
        && diff.hasOnly(allowedChanges);
    }

    // ── Shared catalog collections ───────────────────────────────────────────
    // Materials, customers, and app-wide pricing config are staff-only. There
    // is no public read path for these; they never appear in the approval
    // page (that page reads a single order document).
    match /materials/{materialId} {
      allow read, write: if isStaff();
    }

    match /customers/{customerId} {
      allow read, write: if isStaff();
    }

    match /config/{docId} {
      allow read, write: if isStaff();
    }
  }
}
